# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Cashfree Payment Gateway (Get live credentials after KYC with your PAN at merchant.cashfree.com)
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="production"

# PhonePe Payment Gateway (Get live credentials after KYC with your PAN at business.phonepe.com)
PHONEPE_MERCHANT_ID=""
PHONEPE_SALT_KEY=""
PHONEPE_SALT_INDEX="1"
PHONEPE_ENV="production"

# Optional Server-Side Email Delivery for Password Login Alerts (Gmail App Password or Resend)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""

# Google Maps Platform API Key (Used by @vis.gl/react-google-maps, Places API New, Routes API)
VITE_GOOGLE_MAPS_API_KEY=""
