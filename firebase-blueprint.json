{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role, wallet balance, and contact info",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["passenger", "admin", "provider"] },
        "walletBalance": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "fullName", "role"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Confirmed travel booking ticket record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "bookingRef": { "type": "string" },
        "pnrNumber": { "type": "string" },
        "serviceTitle": { "type": "string" },
        "serviceNumber": { "type": "string" },
        "category": { "type": "string", "enum": ["flights", "trains", "buses", "cars", "autos", "bikes"] },
        "origin": { "type": "string" },
        "destination": { "type": "string" },
        "departureDate": { "type": "string" },
        "status": { "type": "string", "enum": ["confirmed", "cancelled", "completed"] },
        "totalAmount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "bookingRef", "category", "origin", "destination", "status"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Customer care and support inquiry ticket",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string", "format": "email" },
        "category": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "in_progress", "resolved"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userEmail", "category", "subject", "message", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User account documents keyed by Firebase User ID"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Confirmed booking documents for all travel categories"
    },
    "/supportTickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Customer support requests and inquiries"
    }
  }
}
